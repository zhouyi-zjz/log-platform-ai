# K3s cluster and release
NAMESPACE=log-platform
STORAGE_CLASS=local-path
APP_HOST=logs.example.com
INGRESS_CLASS=traefik
TLS_SECRET_NAME=log-platform-tls
SESSION_COOKIE_SECURE=true
BACKEND_REPLICAS=1
FRONTEND_REPLICAS=1

# Images. Push these to a registry reachable by every K3s node, or set LOAD_IMAGES=true
# for a single-node K3s installation with a local Docker daemon.
IMAGE_REPOSITORY=registry.example.com/log-platform
IMAGE_TAG=dev
IMAGE_PULL_POLICY=IfNotPresent
PUSH_IMAGES=false
LOAD_IMAGES=false

# Credentials are required. Use a dedicated MySQL user for the application.
DB_USERNAME=logplatform
DB_PASSWORD=logplatform5350
MYSQL_ROOT_PASSWORD=haige5350
LOG_INGEST_TOKEN=haige5350-logplatform777

# Single-node KRaft defaults for a small K3s installation.
KAFKA_REPLICAS=1
KAFKA_REPLICATION_FACTOR=1

# Persistent volume sizes. Increase them according to docs/capacity/.
MYSQL_STORAGE_SIZE=20Gi
KAFKA_STORAGE_SIZE=50Gi
ES_STORAGE_SIZE=100Gi
ES_JAVA_OPTS="-Xms1g -Xmx1g"

# Image versions are pinned rather than using latest.
MYSQL_IMAGE=mysql:8.4.2
KAFKA_IMAGE=apache/kafka:3.9.1
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.3
CURL_IMAGE=curlimages/curl:8.10.1
FLUENT_BIT_IMAGE=fluent/fluent-bit:3.2.10

# Install the node-local Fluent Bit DaemonSet. It reads /var/log/apps/*.log.
INSTALL_FLUENT_BIT=false
